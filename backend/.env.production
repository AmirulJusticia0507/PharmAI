# Copy these names to the deployment dashboard and set the real values there.
DATABASE_URL=postgresql://user:password@host:5432/database
OPENROUTER_API_KEY=your_openrouter_api_key
OPENAI_API_KEY=your_openai_api_key_for_image_generation
PREMIUM_IMAGE_MODEL=dall-e-3
STANDARD_IMAGE_MODEL=dall-e-2
CORS_ORIGINS=https://your-frontend.vercel.app
ENVIRONMENT=production
