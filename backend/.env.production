# Production Environment Variables Template
# Copy file ini ke .env dan isi dengan nilai production ASLI

# Database (Neon production) - GANTI DENGAN URL ASLI
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# OpenRouter API Key - GANTI DENGAN KEY ASLI
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# CORS Origins (frontend Vercel + local dev) - SESUAIKAN
CORS_ORIGINS=https://pharm-ai-rouge.vercel.app,http://localhost:3000

# Optional: Set production environment
ENVIRONMENT=production