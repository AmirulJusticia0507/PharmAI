# Copy these names to the deployment dashboard and set the real values there.
DATABASE_URL=postgresql://user:password@host:5432/database
OPENROUTER_API_KEY=your_openrouter_api_key
BAZAARLINK_API_KEY=your_bazaarlink_api_key
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1
PREMIUM_IMAGE_MODEL=dall-e-3
STANDARD_IMAGE_MODEL=dall-e-2
CORS_ORIGINS=https://your-frontend.vercel.app
ENVIRONMENT=production
