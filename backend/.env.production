# Copy these names to the deployment dashboard and set the real values there.
DATABASE_URL=postgresql://user:password@host:5432/database
OPENROUTER_API_KEY=your_openrouter_api_key
AI_PROVIDER=griphub
GRIPHUB_API_KEY=your_griphub_api_key
GRIPHUB_BASE_URL=https://griphubrouter.web.id/v1
GRIPHUB_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=your_google_ai_studio_api_key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token
PREMIUM_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
STANDARD_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CORS_ORIGINS=https://your-frontend.vercel.app
ENVIRONMENT=production
